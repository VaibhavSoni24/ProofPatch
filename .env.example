# Application
APP_NAME=ProofPatch
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173

# Execution Mode: "demo" (zero-credential deterministic workflow) or "live" (Nebius + Tavily)
PROOFPATCH_MODE=demo

# Nebius Token Factory (OpenAI-compatible inference)
# Docs: https://docs.tokenfactory.nebius.com/quickstart
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Eligible NVIDIA open-source model identifier (e.g. nvidia/nemotron-4-340b-instruct or similar from Nebius catalog)
NEBIUS_MODEL=

# Tavily Search API (Deep technical research and doc retrieval)
# Docs: https://docs.tavily.com/
TAVILY_API_KEY=
TAVILY_ENABLED=false

# Safety and execution limits
EXECUTION_BACKEND=docker
ALLOW_EXTERNAL_REPOSITORIES=false
MAX_MODEL_CALLS_PER_RUN=4
MAX_PATCH_ITERATIONS=2
MODEL_TIMEOUT_SECONDS=90
SANDBOX_TIMEOUT_SECONDS=60
MAX_REPOSITORY_FILES=300
MAX_CONTEXT_CHARACTERS=40000
MAX_PATCH_BYTES=50000

# Local persistence and workspaces
DATABASE_URL=sqlite:///./data/proofpatch.db
WORKSPACE_ROOT=./data/workspaces

# Logging
LOG_LEVEL=INFO
